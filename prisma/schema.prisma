generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url = env("DATABASE_URL")
}

model migrations {
  id     Int      @id @default(autoincrement())
  name   String   @unique(map: "name") @db.VarChar(255)
  ran_at DateTime @default(now()) @db.Timestamp(0)

  @@map("_migrations")
}

model audit_logs {
  id           Int @id @default(autoincrement())
  company_id   Int?
  title        String?            @db.VarChar(255)
  type         String?            @db.VarChar(100)
  description  String?            @db.Text
  status       audit_logs_status? @default(pending)
  performed_by Int?
  created_at   DateTime           @default(now()) @db.Timestamp(0)
  updated_at   DateTime           @default(now()) @db.Timestamp(0)
}

model companies {
  id             Int @id @default(autoincrement())
  name           String                   @db.VarChar(255)
  email          String?                  @db.VarChar(255)
  phone          String?                  @db.VarChar(50)
  location       String?                  @db.VarChar(255)
  logo_url       String?                  @db.VarChar(500)
  tagline        String?                  @db.VarChar(500)
  plan           String?                  @default("Essentials") @db.VarChar(100)
  billing_cycle  companies_billing_cycle? @default(Monthly)
  payment_method String?                  @db.VarChar(100)
  contact_person String?                  @db.VarChar(255)
  contact        String?                  @db.VarChar(255)
  address        String?                  @db.Text
  business_name  String?                  @db.VarChar(255)
  client_type    companies_client_type?   @default(SaaS)
  tenant_type    companies_tenant_type?   @default(saas)
  saas_fee_paid  Boolean?                 @default(false)
  source         String?                  @db.VarChar(100)
  created_by     Int?
  status         companies_status?        @default(active)
  created_at     DateTime                 @default(now()) @db.Timestamp(0)
  updated_at     DateTime                 @default(now()) @db.Timestamp(0)
}

model customers {
  id          Int @id @default(autoincrement())
  company_id  Int
  created_by  Int?
  name        String?                @db.VarChar(255)
  email       String?                @db.VarChar(255)
  phone       String?                @db.VarChar(50)
  contact     String?                @db.VarChar(255)
  address     String?                @db.Text
  client_type customers_client_type? @default(Direct)
  status      customers_status?      @default(active)
  created_at  DateTime               @default(now()) @db.Timestamp(0)
  updated_at  DateTime               @default(now()) @db.Timestamp(0)
}

model deliveries {
  id                    Int @id @default(autoincrement())
  company_id            Int?
  order_id              Int?
  client_id             Int?
  created_by            Int?
  mission_type          deliveries_mission_type?  @default(Delivery)
  route                 String?                   @db.VarChar(255)
  driver_name           String?                   @db.VarChar(255)
  plate_number          String?                   @db.VarChar(50)
  vehicle_id            Int?
  assigned_driver       Int?
  package_details       String?                   @db.Text
  pickup_location       String?                   @db.VarChar(255)
  drop_location         String?                   @db.VarChar(255)
  delivery_instructions String?                   @db.Text
  delivery_fee          Decimal?                  @default(0.00) @db.Decimal(10, 2)
  payout_status         deliveries_payout_status? @default(none)
  payout_ready_at       DateTime?                 @db.Timestamp(0)
  passenger_info        String?                   @db.Text
  delivery_date         DateTime?                 @db.Date
  pickup_time           DateTime?                 @db.Time(0)
  signature             String?                   @db.Text
  status                deliveries_status?        @default(pending)
  mode                  String?                   @default("Road") @db.VarChar(50)
  created_at            DateTime                  @default(now()) @db.Timestamp(0)
  updated_at            DateTime                  @default(now()) @db.Timestamp(0)
}


model delivery_pricing {
  id          Int @id @default(autoincrement())
  company_id  Int?
  tier_name   String?  @db.VarChar(255)
  price       Decimal? @db.Decimal(12, 2)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @db.Timestamp(0)
}

model events {
  id               Int @id @default(autoincrement())
  company_id       Int?
  name             String         @db.VarChar(255)
  event_date       DateTime?      @db.Date
  location         String?        @db.VarChar(255)
  client_id        Int?
  manager_id       Int?
  status           events_status? @default(planned)
  created_at       DateTime       @default(now()) @db.Timestamp(0)
  updated_at       DateTime       @default(now()) @db.Timestamp(0)
  image_url        String?        @db.VarChar(500)
  special_requests String?        @db.Text
  planner_name     String?        @db.VarChar(255)
  guest_count      Int?           @default(0)
  mood_board_url   String?        @db.VarChar(500)
}


model guest_requests {
  id              Int @id @default(autoincrement())
  company_id      Int?
  client_id       Int?
  guest           String?                  @db.VarChar(255)
  requested_by    String?                  @db.VarChar(255)
  request_details String?                  @db.Text
  delivery_time   DateTime?                @db.Timestamp(0)
  priority        guest_requests_priority? @default(medium)
  status          guest_requests_status?   @default(pending)
  created_at      DateTime                 @default(now()) @db.Timestamp(0)
  updated_at      DateTime                 @default(now()) @db.Timestamp(0)
}

model inventory {
  id             Int @id @default(autoincrement())
  company_id     Int?
  name           String                    @db.VarChar(255)
  sku            String?                   @db.VarChar(100)
  category       String?                   @db.VarChar(100)
  quantity       Int?                      @default(0)
  price          Decimal?                  @default(0.00) @db.Decimal(12, 2)
  threshold      Int?                      @default(10)
  warehouse_id   Int?
  vendor_id      Int?
  client_id      Int?
  inventory_type inventory_inventory_type? @default(Marketplace)
  status         inventory_status?         @default(in_stock)
  image_url      String?                   @db.VarChar(500)
  created_at     DateTime                  @default(now()) @db.Timestamp(0)
  updated_at     DateTime                  @default(now()) @db.Timestamp(0)
  size           String?                   @db.VarChar(255)
  color          String?                   @db.VarChar(255)
  material       String?                   @db.VarChar(255)
  specifications String?                   @db.Text
  description    String?                   @db.Text
}

model inventory_movements {
  id             Int @id @default(autoincrement())
  inventory_id   Int
  type           inventory_movements_type
  quantity       Int
  reference_type String?                  @db.VarChar(100)
  reference_id   Int?
  reason         String?                  @db.Text
  performed_by   Int?
  created_at     DateTime                 @default(now()) @db.Timestamp(0)
}

model invoices {
  id          Int @id @default(autoincrement())
  company_id  Int?
  order_id    Int?
  client_id   Int?
  amount      Decimal          @db.Decimal(12, 2)
  paid_amount Decimal?         @default(0.00) @db.Decimal(12, 2)
  due_date    DateTime?        @db.Date
  status      invoices_status? @default(unpaid)
  created_at  DateTime         @default(now()) @db.Timestamp(0)
  updated_at  DateTime         @default(now()) @db.Timestamp(0)
}

model leave_requests {
  id          Int @id @default(autoincrement())
  company_id  Int?
  user_id     Int
  leave_type  leave_requests_leave_type
  start_date  DateTime                  @db.Date
  end_date    DateTime                  @db.Date
  reason      String?                   @db.Text
  status      leave_requests_status?    @default(pending)
  reviewed_by Int?
  created_at  DateTime                  @default(now()) @db.Timestamp(0)
  updated_at  DateTime                  @default(now()) @db.Timestamp(0)
}

model logistics_tracking {
  id              Int @id @default(autoincrement())
  company_id      Int?
  tracker_id      String?   @db.VarChar(100)
  asset           String?   @db.VarChar(255)
  location        String?   @db.VarChar(255)
  signal_strength String?   @default("Strong") @db.VarChar(50)
  eta             String?   @db.VarChar(100)
  status          String?   @default("Active") @db.VarChar(100)
  delivery_id     Int?
  created_at      DateTime? @default(now()) @db.Timestamp(0)
  updated_at      DateTime? @default(now()) @db.Timestamp(0)
}

model logistics_urgent_tasks {
  id         Int @id @default(autoincrement())
  company_id Int?
  task       String    @db.VarChar(255)
  time_label String?   @default("Immediate") @db.VarChar(100)
  priority   String?   @default("Critical") @db.VarChar(50)
  location   String?   @db.VarChar(255)
  assignee   String?   @default("Pending") @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
}

model luxury_items {
  id              Int @id @default(autoincrement())
  company_id      Int?
  item_name       String               @db.VarChar(255)
  owner_name      String?              @db.VarChar(255)
  vault_location  String?              @db.VarChar(255)
  estimated_value Decimal?             @db.Decimal(15, 2)
  status          luxury_items_status? @default(Stored)
  notes           String?              @db.Text
  created_at      DateTime             @default(now()) @db.Timestamp(0)
  updated_at      DateTime             @default(now()) @db.Timestamp(0)
}

model menu_permissions {
  id         Int @id @default(autoincrement())
  company_id Int?
  role       String   @db.VarChar(100)
  menu_name  String   @db.VarChar(255)
  can_view   Boolean? @default(true)
  can_create Boolean? @default(false)
  can_edit   Boolean? @default(false)
  can_delete Boolean? @default(false)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
}

model missions {
  id               Int @id @default(autoincrement())
  company_id       Int?
  order_id         Int?
  project_id       Int?
  mission_type     missions_mission_type? @default(Delivery)
  destination_type String?                @db.VarChar(100)
  assigned_driver  Int?
  vehicle_id       Int?
  status           missions_status?       @default(pending)
  event_date       DateTime?              @db.Date
  notes            String?                @db.Text
  created_at       DateTime               @default(now()) @db.Timestamp(0)
  updated_at       DateTime               @default(now()) @db.Timestamp(0)
}

model notifications {
  id          Int @id @default(autoincrement())
  company_id  Int?
  user_id     Int?
  role_target String?   @db.VarChar(50)
  type        String    @default("info") @db.VarChar(50)
  title       String    @db.VarChar(255)
  message     String?   @db.Text
  link        String?   @db.VarChar(255)
  is_read     Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
}

model order_flow_logs {
  id           Int       @id @default(autoincrement())
  order_id     Int
  stage        String?   @db.VarChar(64)
  assigned_to  Int?
  assigned_by  Int?
  status       String?   @db.VarChar(64)
  notes        String?   @db.Text
  started_at   DateTime? @default(now()) @db.Timestamp(0)
  completed_at DateTime? @db.Timestamp(0)
}

model order_items {
  id           Int      @id @default(autoincrement())
  order_id     Int
  product_name String   @db.VarChar(255)
  category     String?  @db.VarChar(100)
  qty          Int?     @default(1)
  unit_price   Decimal? @default(0.00) @db.Decimal(12, 2)
  total_price  Decimal? @default(0.00) @db.Decimal(12, 2)
  created_at   DateTime @default(now()) @db.Timestamp(0)
}

model orders {
  id                    Int @id @default(autoincrement())
  company_id            Int
  customer_id           Int?
  client_name           String?               @db.VarChar(255)
  vendor_id             Int?
  created_by            Int?
  type                  String?               @default("Custom Order") @db.VarChar(100)
  items                 String?               @db.Text
  notes                 String?               @db.Text
  delivery_instructions String?               @db.Text
  location              String?               @db.VarChar(255)
  delivery_address      String?               @db.VarChar(500)
  total_amount          Decimal?              @default(0.00) @db.Decimal(12, 2)
  status                orders_status?        @default(created)
  current_stage         orders_current_stage? @default(created)
  assigned_to           Int?
  order_date            DateTime?             @db.Date
  due_date              DateTime?             @db.Date
  created_at            DateTime              @default(now()) @db.Timestamp(0)
  updated_at            DateTime              @default(now()) @db.Timestamp(0)
  pickup_location       String?               @db.VarChar(255)
}

model password_resets {
  id         Int @id @default(autoincrement())
  email      String   @db.VarChar(255)
  otp        String   @db.VarChar(10)
  expires_at DateTime @db.Timestamp(0)
  used       Boolean? @default(false)
  created_at DateTime @default(now()) @db.Timestamp(0)
}

model payments {
  id             Int @id @default(autoincrement())
  invoice_id     Int
  amount         Decimal  @db.Decimal(12, 2)
  payment_method String?  @db.VarChar(100)
  transaction_id String?  @db.VarChar(255)
  created_at     DateTime @default(now()) @db.Timestamp(0)
}

model payroll {
  id                Int @id @default(autoincrement())
  company_id        Int?
  user_id           Int
  payment_date      DateTime?       @db.Date
  gross_amount      Decimal?        @db.Decimal(12, 2)
  deductions        Decimal?        @default(0.00) @db.Decimal(12, 2)
  net_amount        Decimal?        @db.Decimal(12, 2)
  status            payroll_status? @default(pending)
  created_at        DateTime        @default(now()) @db.Timestamp(0)
  base_salary       Decimal?        @default(0.00) @db.Decimal(12, 2)
  bonus             Decimal?        @default(0.00) @db.Decimal(12, 2)
  nib_deduction     Decimal?        @default(0.00) @db.Decimal(12, 2)
  medical_deduction Decimal?        @default(0.00) @db.Decimal(12, 2)
  pension_deduction Decimal?        @default(0.00) @db.Decimal(12, 2)
  savings_deduction Decimal?        @default(0.00) @db.Decimal(12, 2)
  birthday_club     Decimal?        @default(0.00) @db.Decimal(12, 2)
  method            String?         @default("Direct Deposit") @db.VarChar(100)
}

model projects {
  id            Int              @id @default(autoincrement())
  company_id    Int?
  customer_id   Int?
  client_name   String?          @db.VarChar(255)
  order_id      Int?
  name          String           @db.VarChar(255)
  description   String?          @db.Text
  manager_id    Int?
  location      String?          @db.VarChar(255)
  status        projects_status? @default(planned)
  start_date    DateTime?        @db.Date
  end_date      DateTime?        @db.Date
  delivery_type String?          @default("Road") @db.VarChar(50)
  created_at    DateTime         @default(now()) @db.Timestamp(0)
  updated_at    DateTime         @default(now()) @db.Timestamp(0)
}

model purchase_orders {
  id            Int @id @default(autoincrement())
  company_id    Int?
  vendor_id     Int
  items         String?                 @db.Text
  total_amount  Decimal?                @db.Decimal(12, 2)
  notes         String?                 @db.Text
  payment_terms String?                 @default("Net 30") @db.VarChar(255)
  status        purchase_orders_status? @default(Pending)
  created_at    DateTime                @default(now()) @db.Timestamp(0)
  updated_at    DateTime                @default(now()) @db.Timestamp(0)
}

model purchase_requests {
  id             Int @id @default(autoincrement())
  company_id     Int?
  item_name      String?                     @db.VarChar(255)
  items          String?                     @db.Text
  category       String?                     @db.VarChar(100)
  quantity       Int?
  estimated_cost Decimal?                    @db.Decimal(12, 2)
  requester      String?                     @db.VarChar(255)
  requester_id   Int?
  status         purchase_requests_status?
  priority       purchase_requests_priority? @default(Normal)
  notes          String?                     @db.Text
  department     String?                     @db.VarChar(255)
  created_at     DateTime                    @default(now()) @db.Timestamp(0)
  updated_at     DateTime                    @default(now()) @db.Timestamp(0)
}

model quotes {
  id                  Int @id @default(autoincrement())
  company_id          Int?
  vendor_id           Int
  purchase_request_id Int?
  items               String?        @db.Text
  total_amount        Decimal?       @db.Decimal(12, 2)
  validity_date       DateTime?      @db.Date
  status              quotes_status? @default(Pending)
  notes               String?        @db.Text
  created_at          DateTime       @default(now()) @db.Timestamp(0)
  updated_at          DateTime       @default(now()) @db.Timestamp(0)
}

model routes {
  id             Int @id @default(autoincrement())
  company_id     Int?
  name           String         @db.VarChar(255)
  start_location String?        @db.VarChar(255)
  end_location   String?        @db.VarChar(255)
  distance_km    Decimal?       @db.Decimal(10, 2)
  estimated_time String?        @db.VarChar(100)
  type           routes_type?   @default(Land)
  status         routes_status? @default(Active)
  created_at     DateTime       @default(now()) @db.Timestamp(0)
  updated_at     DateTime       @default(now()) @db.Timestamp(0)
}

model saas_plans {
  id            Int @id @default(autoincrement())
  name          String                    @db.VarChar(255)
  price         Decimal                   @db.Decimal(12, 2)
  billing_cycle saas_plans_billing_cycle? @default(Monthly)
  features      String?                   @db.Text
  max_users     Int?                      @default(10)
  max_orders    Int?                      @default(100)
  status        saas_plans_status?        @default(active)
  created_at    DateTime                  @default(now()) @db.Timestamp(0)
  updated_at    DateTime                  @default(now()) @db.Timestamp(0)
}

model saas_requests {
  id             Int @id @default(autoincrement())
  client_name    String                @db.VarChar(255)
  email          String                @db.VarChar(255)
  phone          String?               @db.VarChar(50)
  company_name   String?               @db.VarChar(255)
  plan           String?               @db.VarChar(100)
  contact_person String?               @db.VarChar(255)
  country        String?               @db.VarChar(100)
  status         saas_requests_status? @default(Pending)
  created_at     DateTime              @default(now()) @db.Timestamp(0)
  updated_at     DateTime              @default(now()) @db.Timestamp(0)
}

model shifts {
  id             Int @id @default(autoincrement())
  company_id     Int?
  user_id        Int
  clock_in       DateTime  @db.Timestamp(0)
  clock_out      DateTime? @db.Timestamp(0)
  location       String?   @db.VarChar(255)
  duration_hours Decimal?  @db.Decimal(6, 2)
  created_at     DateTime  @default(now()) @db.Timestamp(0)
}

model staff_assignments {
  id                Int @id @default(autoincrement())
  company_id        Int?
  assignee_id       Int
  task              String?                     @db.VarChar(500)
  location          String?                     @db.VarChar(255)
  status            staff_assignments_status?   @default(Pending)
  priority          staff_assignments_priority? @default(Normal)
  mission_type      String?                     @db.VarChar(100)
  passenger_name    String?                     @db.VarChar(255)
  pickup_time       DateTime?                   @db.Timestamp(0)
  drop_location     String?                     @db.VarChar(255)
  pickup_location   String?                     @db.VarChar(255)
  delivery_location String?                     @db.VarChar(255)
  luggage           String?                     @db.VarChar(255)
  goods_details     String?                     @db.Text
  weight            String?                     @db.VarChar(50)
  created_at        DateTime                    @default(now()) @db.Timestamp(0)
  updated_at        DateTime                    @default(now()) @db.Timestamp(0)
}

model support_tickets {
  id             Int @id @default(autoincrement())
  company_id     Int?
  subject        String                          @db.VarChar(255)
  category       String?                         @default("General") @db.VarChar(100)
  description    String?                         @db.Text
  messages       String?                         @db.Text
  priority       support_tickets_priority?       @default(medium)
  status         support_tickets_status?         @default(open)
  dispute_status support_tickets_dispute_status? @default(none)
  refund_amount  Decimal?                        @default(0.00) @db.Decimal(10, 2)
  submitted_by   Int?
  assigned_to    Int?
  created_at     DateTime                        @default(now()) @db.Timestamp(0)
  updated_at     DateTime                        @default(now()) @db.Timestamp(0)
}

model system_settings {
  id            Int @id @default(autoincrement())
  company_id    Int?
  setting_key   String   @db.VarChar(255)
  setting_value String?  @db.Text
  updated_at    DateTime @default(now()) @db.Timestamp(0)
}

model users {
  id                         Int @id @default(autoincrement())
  company_id                 Int?
  created_by                 Int?
  name                       String                   @db.VarChar(255)
  email                      String                   @db.VarChar(255)
  password                   String                   @db.VarChar(255)
  phone                      String?                  @db.VarChar(50)
  role                       users_role               @default(staff)
  is_available               Boolean?                 @default(true)
  employment_status          users_employment_status? @default(Full_Time)
  birthday                   DateTime?                @db.Date
  bank_name                  String?                  @db.VarChar(255)
  account_number             String?                  @db.VarChar(255)
  routing_number             String?                  @db.VarChar(255)
  nib_number                 String?                  @db.VarChar(100)
  vacation_balance           Int?                     @default(0)
  passport_url               String?                  @db.VarChar(500)
  license_url                String?                  @db.VarChar(500)
  nib_doc_url                String?                  @db.VarChar(500)
  police_record_url          String?                  @db.VarChar(500)
  profile_pic_url            String?                  @db.VarChar(500)
  business_license_url       String?                  @db.VarChar(500)
  status                     users_status?            @default(active)
  joined_date                DateTime?                @db.Date
  created_at                 DateTime                 @default(now()) @db.Timestamp(0)
  updated_at                 DateTime                 @default(now()) @db.Timestamp(0)
  plan                       String?                  @default("Free") @db.VarChar(100)
  is_upgraded                Boolean?                 @default(false)
  concierge_member           Boolean?                 @default(false)
  concierge_membership_since DateTime?                @db.Date
}

model vehicles {
  id                  Int @id @default(autoincrement())
  company_id          Int?
  plate_number        String                 @db.VarChar(50)
  model               String?                @db.VarChar(255)
  type                String?                @db.VarChar(100)
  vehicle_type        vehicles_vehicle_type? @default(Car)
  capacity            String?                @db.VarChar(50)
  fuel_level          Int?                   @default(100)
  status              vehicles_status?       @default(available)
  insurance_policy    String?                @db.VarChar(255)
  registration_expiry DateTime?              @db.Date
  inspection_date     DateTime?              @db.Date
  diagnostic_status   String?                @db.VarChar(100)
  created_at          DateTime               @default(now()) @db.Timestamp(0)
  updated_at          DateTime               @default(now()) @db.Timestamp(0)
}

model vendors {
  id           Int @id @default(autoincrement())
  company_id   Int?
  created_by   Int?
  name         String          @db.VarChar(255)
  email        String?         @db.VarChar(255)
  phone        String?         @db.VarChar(50)
  contact_name String?         @db.VarChar(255)
  category     String?         @db.VarChar(100)
  location     String?         @db.VarChar(255)
  rating       Decimal         @default(0.00) @db.Decimal(5, 2)
  delivery     Decimal         @default(0.00) @db.Decimal(5, 2)
  status       vendors_status? @default(active)
  created_at   DateTime        @default(now()) @db.Timestamp(0)
  updated_at   DateTime        @default(now()) @db.Timestamp(0)
}

model warehouses {
  id         Int @id @default(autoincrement())
  company_id Int?
  name       String             @db.VarChar(255)
  location   String?            @db.VarChar(255)
  capacity   Int?
  manager_id Int?
  status     warehouses_status? @default(active)
  created_at DateTime           @default(now()) @db.Timestamp(0)
  updated_at DateTime           @default(now()) @db.Timestamp(0)
}

enum inventory_movements_type {
  entry
  issue
  loss
  adjustment
}

